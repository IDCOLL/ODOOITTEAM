<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_expiry_date" model="ir.ui.view">
        <field name="name">sale.order.form.expiry.date</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add personal expiry date field below payment_term_id -->
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="personal_expiry_date"/>
            </xpath>
        </field>
    </record>
</odoo>
