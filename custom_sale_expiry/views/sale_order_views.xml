<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_personal_expiry" model="ir.ui.view">
        <field name="name">sale.order.form.personal.expiry</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add the personal expiry date field after the validity_date field -->
            <xpath expr="//field[@name='validity_date']" position="after">
                <field name="personal_expiry_date" attrs="{'invisible': [('state', 'in', ['cancel'])]}"/>
            </xpath>
        </field>
    </record>
</odoo>