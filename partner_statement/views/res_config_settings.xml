<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="res_config_settings_view_form_inherited_simple">
        <field name="name">res.config.settings.view.form.inherited.partner.statement.simple</field>
        <field name="model">res.config.settings</field>
        <field name="priority">90</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@title='Invoicing']" position="after">
                <block title="Partner Statements" id="partner_statement_section">
                    <setting id="partner_statement_activity" title="Enable Activity Statements">
                        <field name="group_activity_statement" />
                        <div class="text-muted">
                            Generate activity statements showing all partner transactions between two dates
                        </div>
                        <div class="content-group" invisible="[('group_activity_statement', '=', False)]">
                            <div class="row">
                                <label for="default_aging_type" class="col-3 col-lg-3 o_light_label"/>
                                <field name="default_aging_type" />
                            </div>
                            <div>
                                <field name="default_show_aging_buckets" class="oe_inline"/>
                                <label for="default_show_aging_buckets" class="o_light_label"/>
                            </div>
                            <div>
                                <field name="default_filter_partners_non_due" class="oe_inline"/>
                                <label for="default_filter_partners_non_due" class="o_light_label"/>
                            </div>
                            <div>
                                <field name="default_filter_negative_balances" class="oe_inline"/>
                                <label for="default_filter_negative_balances" class="o_light_label"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="partner_statement_outstanding" title="Enable Outstanding Statements">
                        <field name="group_outstanding_statement" />
                        <div class="text-muted">
                            Generate outstanding statements showing all open transactions up to a specific date
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>