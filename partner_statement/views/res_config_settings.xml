<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="res_config_settings_view_form_inherited">
        <field name="name">res.config.settings.view.form.inherited.partner.statement</field>
        <field name="model">res.config.settings</field>
        <field name="priority">90</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="group_activity_statement" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="group_activity_statement" string="Activity Statements"/>
                        <div class="text-muted">
                            Generate activity statements showing all partner transactions between two dates
                        </div>
                        <div class="content-group">
                            <div class="mt16">
                                <label for="default_aging_type" string="Default Aging Method"/>
                                <field name="default_aging_type" />
                            </div>
                            <div class="mt8">
                                <field name="default_show_aging_buckets" class="oe_inline"/>
                                <label for="default_show_aging_buckets" string="Show Aging Buckets by Default"/>
                            </div>
                            <div class="mt8">
                                <field name="default_filter_partners_non_due" class="oe_inline"/>
                                <label for="default_filter_partners_non_due" string="Exclude Partners with No Due Entries"/>
                            </div>
                            <div class="mt8">
                                <field name="default_filter_negative_balances" class="oe_inline"/>
                                <label for="default_filter_negative_balances" string="Exclude Negative Balances"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="group_outstanding_statement" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="group_outstanding_statement" string="Outstanding Statements"/>
                        <div class="text-muted">
                            Generate outstanding statements showing all open transactions up to a specific date
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>