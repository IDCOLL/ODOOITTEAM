<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_notes" model="ir.ui.view">
        <field name="name">sale.order.form.notes</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add notes field after the partner information group -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="order_notes" placeholder="Enter any additional notes or information for this sales order..."/>
            </xpath>
        </field>
    </record>
</odoo>