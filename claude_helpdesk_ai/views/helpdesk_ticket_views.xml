<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend Helpdesk Ticket Form View -->
        <record id="view_helpdesk_ticket_form_claude_ai" model="ir.ui.view">
            <field name="name">helpdesk.ticket.form.claude.ai</field>
            <field name="model">helpdesk.ticket</field>
            <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
            <field name="arch" type="xml">
                <!-- Add buttons in header -->
                <header position="inside">
                    <button name="action_analyze_with_claude"
                            string="Analyze with Claude AI"
                            type="object"
                            class="btn-primary"
                            invisible="x_ai_analyzed or x_needs_clarification"/>
                    <button name="action_submit_clarification"
                            string="Submit Clarification"
                            type="object"
                            class="btn-warning"
                            invisible="not x_needs_clarification"/>
                    <button name="action_create_github_pr"
                            string="Create GitHub PR"
                            type="object"
                            class="btn-secondary"
                            invisible="not x_ai_analyzed or x_github_pr_url or not x_proposed_changes or x_needs_clarification"/>
                    <button name="action_open_github_pr"
                            string="Open Pull Request"
                            type="object"
                            class="btn-info"
                            invisible="not x_github_pr_url"/>
                    <button name="action_delete_ai_branch"
                            string="Delete AI Branch"
                            type="object"
                            class="btn-danger"
                            confirm="This will close the PR and delete the AI branch. Are you sure?"
                            invisible="not x_github_branch"/>
                    <button name="action_mark_fix_working"
                            string="Fix Working"
                            type="object"
                            class="btn-success"
                            invisible="not x_ai_analyzed or x_feedback_status == 'working' or x_needs_clarification"/>
                    <button name="action_reanalyze_with_feedback"
                            string="Re-analyze with Feedback"
                            type="object"
                            class="btn-warning"
                            invisible="not x_ai_analyzed or not x_feedback_text or x_feedback_status not in ('not_working', 'partial') or x_needs_clarification"/>
                </header>

                <!-- Add notebook pages -->
                <xpath expr="//notebook" position="inside">
                    <!-- Clarification Request page (shown when Claude needs info) -->
                    <page string="Clarification Needed" name="clarification" invisible="not x_needs_clarification">
                        <div class="alert alert-warning" role="alert">
                            <h4 class="alert-heading">Claude AI needs more information</h4>
                            <p>Please answer the questions below so Claude can provide an accurate solution.</p>
                        </div>
                        <group>
                            <field name="x_claude_analysis" nolabel="1" readonly="1"/>
                        </group>
                        <separator string="Your Response"/>
                        <group>
                            <field name="x_clarification_response"
                                   placeholder="Please answer the questions above here. Be as specific as possible..."
                                   nolabel="1"/>
                        </group>
                        <group>
                            <button name="action_submit_clarification"
                                    string="Submit Clarification and Continue Analysis"
                                    type="object"
                                    class="btn-warning btn-lg"/>
                        </group>
                        <group string="Clarification History" invisible="not x_clarification_history">
                            <field name="x_clarification_history" nolabel="1" readonly="1"/>
                        </group>
                    </page>

                    <!-- AI Analysis & Code page -->
                    <page string="AI Analysis &amp; Code" name="ai_analysis" invisible="not x_ai_analyzed or x_needs_clarification">
                        <group>
                            <group string="Analysis Information">
                                <field name="x_analysis_date"/>
                                <field name="x_estimated_hours"/>
                                <field name="x_affected_module"/>
                                <field name="x_reanalysis_count"/>
                            </group>
                            <group string="GitHub Information">
                                <field name="x_github_branch"/>
                                <field name="x_github_pr_number"/>
                                <field name="x_github_pr_url" widget="url"/>
                            </group>
                        </group>
                        <group>
                            <field name="x_claude_analysis" nolabel="1"/>
                        </group>
                        <group string="Proposed Code Changes" invisible="not x_proposed_changes">
                            <field name="x_proposed_changes" nolabel="1"/>
                        </group>
                        <separator string="Feedback on AI Solution"/>
                        <group>
                            <group>
                                <field name="x_feedback_status" widget="radio" options="{'horizontal': true}"/>
                                <field name="x_feedback_date" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="x_feedback_text"
                                   placeholder="If the fix didn't work, describe what went wrong, any new errors, or what behavior you expected vs what actually happened..."
                                   nolabel="1"/>
                        </group>
                        <group>
                            <button name="action_submit_feedback"
                                    string="Submit Feedback"
                                    type="object"
                                    class="btn-primary"
                                    invisible="not x_feedback_status"/>
                        </group>
                        <group string="Feedback History" invisible="not x_feedback_history">
                            <field name="x_feedback_history" nolabel="1" readonly="1"/>
                        </group>
                        <group string="Clarification History" invisible="not x_clarification_history">
                            <field name="x_clarification_history" nolabel="1" readonly="1"/>
                        </group>
                        <group string="Full API Response (Debug)">
                            <field name="x_claude_analysis_json" nolabel="1"/>
                        </group>
                    </page>

                    <!-- Technical Details page -->
                    <page string="Technical Details" name="technical_details">
                        <group>
                            <field name="x_affected_module" placeholder="e.g., sale, purchase, custom_module"/>
                            <field name="x_error_logs" placeholder="Paste error logs or stack traces here..." nolabel="1"/>
                            <field name="x_steps_to_reproduce" placeholder="1. Go to...&#10;2. Click on...&#10;3. See error..." nolabel="1"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Extend Helpdesk Ticket Tree View -->
        <record id="view_helpdesk_ticket_tree_claude_ai" model="ir.ui.view">
            <field name="name">helpdesk.ticket.tree.claude.ai</field>
            <field name="model">helpdesk.ticket</field>
            <field name="inherit_id" ref="helpdesk.helpdesk_tickets_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <field name="x_ai_analyzed" optional="show"/>
                    <field name="x_pr_created" optional="show"/>
                    <field name="x_needs_clarification" optional="show"/>
                    <field name="x_feedback_status" optional="hide"/>
                    <field name="x_reanalysis_count" optional="hide"/>
                </xpath>
            </field>
        </record>

        <!-- Extend Helpdesk Ticket Search View -->
        <record id="view_helpdesk_ticket_search_claude_ai" model="ir.ui.view">
            <field name="name">helpdesk.ticket.search.claude.ai</field>
            <field name="model">helpdesk.ticket</field>
            <field name="inherit_id" ref="helpdesk.helpdesk_tickets_view_search"/>
            <field name="arch" type="xml">
                <search position="inside">
                    <filter string="AI Analyzed" name="filter_ai_analyzed"
                            domain="[('x_ai_analyzed', '=', True)]"/>
                    <filter string="PR Created" name="filter_pr_created"
                            domain="[('x_pr_created', '=', True)]"/>
                    <filter string="Not Analyzed" name="filter_not_analyzed"
                            domain="[('x_ai_analyzed', '=', False)]"/>
                    <filter string="Needs Clarification" name="filter_needs_clarification"
                            domain="[('x_needs_clarification', '=', True)]"/>
                    <separator/>
                    <filter string="Fix Working" name="filter_fix_working"
                            domain="[('x_feedback_status', '=', 'working')]"/>
                    <filter string="Fix Not Working" name="filter_fix_not_working"
                            domain="[('x_feedback_status', '=', 'not_working')]"/>
                    <filter string="Needs Re-analysis" name="filter_needs_reanalysis"
                            domain="[('x_feedback_status', 'in', ('not_working', 'partial')), ('x_feedback_text', '!=', False)]"/>
                </search>
            </field>
        </record>
    </data>
</odoo>
