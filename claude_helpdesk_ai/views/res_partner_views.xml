<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend Partner Form View -->
        <record id="view_partner_form_claude_ai" model="ir.ui.view">
            <field name="name">res.partner.form.claude.ai</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page string="Claude AI &amp; GitHub" name="claude_ai_github">
                        <group>
                            <group string="Project Configuration">
                                <field name="x_project_type" widget="radio" options="{'horizontal': false}"/>
                            </group>
                            <group string="GitHub Configuration">
                                <field name="x_github_repo" placeholder="https://github.com/owner/repo"/>
                                <field name="x_github_token" widget="password"/>
                                <field name="x_github_default_branch"/>
                                <field name="x_github_dev_branch_prefix"/>
                                <button name="action_test_github_connection"
                                        string="Test Connection"
                                        type="object"
                                        class="btn-primary"
                                        invisible="not x_github_repo"/>
                            </group>
                        </group>
                        <!-- Odoo Environment (visible for Odoo projects) -->
                        <group invisible="x_project_type != 'odoo'">
                            <group string="Odoo Environment">
                                <field name="x_odoo_version"/>
                                <field name="x_custom_modules" placeholder="module1, module2, module3"/>
                                <field name="x_odoo_config_notes" placeholder="Additional environment details, customizations, or architecture notes..."/>
                            </group>
                        </group>
                        <!-- Custom App Configuration (visible for non-Odoo projects) -->
                        <group invisible="x_project_type == 'odoo'">
                            <group string="Application Configuration">
                                <field name="x_app_framework_version" placeholder="e.g., Vue 3.4, React 18, Node 20"/>
                                <field name="x_app_tech_stack" placeholder="e.g., Vue 3 + Pinia + Vue Router, Node.js + Express, PostgreSQL"/>
                            </group>
                            <group string="Architecture Details">
                                <field name="x_app_architecture_notes" placeholder="Describe the application architecture, folder structure, key patterns used..."/>
                            </group>
                        </group>
                        <group invisible="x_project_type == 'odoo'">
                            <group string="Build Commands">
                                <field name="x_app_build_commands" placeholder="npm install&#10;npm run dev&#10;npm run build"/>
                            </group>
                            <group string="Test Commands">
                                <field name="x_app_test_commands" placeholder="npm run test&#10;npm run test:e2e"/>
                            </group>
                        </group>
                        <group invisible="x_project_type == 'odoo'">
                            <group string="Key Files/Directories">
                                <field name="x_app_key_files" placeholder="src/components/ - Vue components&#10;src/stores/ - Pinia stores&#10;src/api/ - API client"/>
                            </group>
                        </group>
                        <group>
                            <group string="AI Settings">
                                <field name="x_enable_auto_analysis"/>
                                <field name="x_auto_create_pr"/>
                            </group>
                            <group string="Statistics">
                                <field name="x_total_tickets_analyzed"/>
                                <field name="x_total_prs_created"/>
                                <button name="action_view_analyzed_tickets"
                                        string="View Analyzed Tickets"
                                        type="object"
                                        class="btn-link"
                                        invisible="x_total_tickets_analyzed == 0"/>
                                <button name="action_refresh_cache"
                                        string="Refresh Statistics"
                                        type="object"
                                        class="btn-secondary"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>
    </data>
</odoo>
