<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Sale Order Form View to add Custom Order Date field -->
        <record id="view_order_form_custom_date" model="ir.ui.view">
            <field name="name">sale.order.form.custom.date</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!-- Add custom order date field after the date_order field in the header -->
                <xpath expr="//field[@name='date_order']" position="after">
                    <field name="custom_order_date" 
                           widget="date"
                           options="{'datepicker': {'warn_future': false}}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
